# Copy to stack.env for Docker Compose, or enter the values in Portainer.
# Fill in the four required values before deploying.

# Tailscale auth key and exit-node Tailscale IP
TS_AUTHKEY=
TS_EXIT_NODE=
TS_UDP_PORT=53035

# BotFather token and comma-separated numeric chat IDs
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHATS=

# Use MUSIC_PATH for docker-compose.yml.
MUSIC_PATH=/srv/music
# For docker-compose.volume.yml, set the name of an existing volume instead.
# MUSIC_VOLUME=
# MUSIC_SUBDIR=music
PUID=1000
PGID=1000

# Optional media library rescans
PLEX_URL=http://host.docker.internal:32400
PLEX_TOKEN=
PLEX_MUSIC_PATH=
NAVIDROME_URL=
NAVIDROME_USER=
NAVIDROME_PASSWORD=

EXIT_NODE_FALLBACK=true
JIOSAAVN_WHEN_FALLBACK=false
NO_PROXY_EXTRA=
TZ=Etc/UTC

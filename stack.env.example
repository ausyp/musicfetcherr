# Paste into Portainer → Stack → Environment variables (Advanced mode)

# Tailscale
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx      # reusable key from the Tailscale admin console
TS_EXIT_NODE=100.x.y.z                   # Tailscale IP of your India exit node

# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC...         # from @BotFather
TELEGRAM_ALLOWED_CHATS=111111111         # your chat ID (comma-separate several)

# Plex / Plexamp
PLEX_TOKEN=                              # your X-Plex-Token
PLEX_MUSIC_PATH=                         # optional: MUSIC_PATH as Plex sees it, for faster per-album scans

# Navidrome (optional: your existing server; leave blank to skip)
NAVIDROME_URL=                           # e.g. http://192.168.1.20:4533 or http://100.x.y.z:4533
NAVIDROME_USER=
NAVIDROME_PASSWORD=

# Where songs are saved — use ONE of these:
#  a) a folder on the server        (compose path: docker-compose.yml)
MUSIC_PATH=/srv/music
#  b) an existing Docker volume, e.g. an SMB share  (compose path: docker-compose.volume.yml)
# MUSIC_VOLUME=nas-media                # volume name exactly as in Portainer → Volumes
# MUSIC_SUBDIR=music                    # folder inside the volume
PUID=1000                                # user that can write there
PGID=1000

# If the India exit node is down
EXIT_NODE_FALLBACK=true                  # true = use your normal connection until India is back; false = wait for India
